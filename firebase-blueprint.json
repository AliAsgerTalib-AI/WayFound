{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Itinerary": {
      "title": "Itinerary",
      "description": "A generated travel itinerary",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner of the itinerary" },
        "destination": { "type": "string", "description": "Trip destination" },
        "duration": { "type": "number", "description": "Trip duration in days" },
        "budgetAmount": { "type": "number", "description": "Target budget" },
        "travelStyle": { "type": "string", "description": "Selected travel style" },
        "itineraryData": { "type": "object", "description": "The full generated itinerary content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Generation timestamp" }
      },
      "required": ["userId", "destination", "duration"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/itineraries/{itineraryId}": {
      "schema": "Itinerary",
      "description": "Stored travel itineraries"
    }
  }
}
